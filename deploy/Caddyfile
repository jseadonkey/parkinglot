# TLS via Let's Encrypt (HTTP-01). Point UI_HOST and API_HOST DNS A/AAAA records at this Droplet first.
# Env vars are set by docker compose (see deploy/env.production.example).

{
	email {$ACME_EMAIL}
}

{$UI_HOST} {
	encode gzip
	# OR segments: `/operator/*` alone does not match bare `/operator` or `/operator/` (Caddy path docs).
	@operator path /operator /operator/ /operator/*
	handle @operator {
		reverse_proxy operator-console:3000
	}
	# Shorthand paths → operator console (approval-ui next.config also redirects these).
	@operator_alias path /outreach /outreach/* /deals /deals/* /parcels /parcels/* /audit /audit/* /owners /owners/* /approvals /approvals/*
	handle @operator_alias {
		redir * /operator{uri} 308
	}
	handle {
		reverse_proxy approval-ui:3000
	}
}

{$API_HOST} {
	encode gzip
	reverse_proxy api:8000
}

# Copy to deploy/.env on the Droplet (never commit deploy/.env).

# --- Release label (shown in /health and /ready) ---
# docker-compose.production.yml: set APP_VERSION to label each on-droplet build (default in compose is dev).
# GHCR images: version is baked in at image build (Git SHA); leave APP_VERSION unset unless you inject it via an override.
# APP_VERSION=1.0.0

# --- Optional: pre-built images (see docs/GHCR-DEPLOY.md) ---
# API_IMAGE=ghcr.io/yourgithubuser/parking-acquisition-api:latest
# APPROVAL_UI_IMAGE=ghcr.io/yourgithubuser/parking-acquisition-approval-ui:latest

# --- Let's Encrypt (required for certificate notifications) ---
ACME_EMAIL=you@yourdomain.com

# --- Public URLs (browser + Caddy TLS hostnames) ---
# Example: UI on https://parking.example.com and API on https://api.parking.example.com
UI_HOST=parking.example.com
API_HOST=api.parking.example.com
PUBLIC_API_URL=https://api.parking.example.com
#
# Operator console (parcels / deals / approvals browser UI): same UI_HOST as approval UI, path /operator
#   https://parking.example.com/operator   — see docs/OPERATOR-CONSOLE.md
# Post-deploy Slack script curls this host from the Droplet; if DNS fails there (curl exit 6), set:
# LOCAL_API_FALLBACK=http://127.0.0.1:18000

# --- Caddy: host ports + TLS mode (when 80/443 are already used on the Droplet) ---
# Default: publish 80/443 and use Let's Encrypt (./Caddyfile). Another stack on the same VM
# often binds 0.0.0.0:80 and :443; then set alternate host ports and internal TLS, and put
# the port in PUBLIC_API_URL / CORS if browsers hit the API on a non-443 port, e.g.:
#   CADDY_PUBLISH_HTTP=9080
#   CADDY_PUBLISH_HTTPS=9443
#   CADDY_CADDYFILE=./Caddyfile.internal-tls
#   PUBLIC_API_URL=https://api.parking.example.com:9443
#   CORS_ALLOW_ORIGINS=https://parking.example.com:9443
#   (UI origin must match the approval UI URL users load, including port.)
# (Paths are relative to this deploy/ directory.)
# CADDY_PUBLISH_HTTP=80
# CADDY_PUBLISH_HTTPS=443
# CADDY_CADDYFILE=./Caddyfile

# --- API: CORS (must include the exact approval UI origin, with scheme) ---
CORS_ALLOW_ORIGINS=https://parking.example.com

# --- API: protect /internal/* (ingest triggers). Generate: openssl rand -hex 32 ---
INTERNAL_API_KEY=

# --- Browser UI login (approval UI + operator console). Set these in this file (deploy/.env on the server).
# Compose loads this file into the UI containers (env_file). Omit AUTH_SECRET to leave UIs open (dev/CI only).
# AUTH_SECRET=
# AUTH_ADMIN_EMAIL=
# AUTH_ADMIN_PASSWORD=
# AUTH_VIEWER_USERNAME=
# AUTH_VIEWER_PASSWORD=

# --- Optional: zoning rule YAML (surface parking by zone). Empty uses /app/data/zoning/wa/... in Docker ---
# ZONING_RULES_PATH=/app/data/zoning/wa/kent_king_surface_parking_rules.yaml

# --- Phase B automation (King/Kent pilot): Esri Feature Layer base URLs (…/FeatureServer/0) or paths to GeoJSON ---
# Discover property keys: python3 scripts/inspect_zoning_layer.py "$URL"
# Defaults for zone columns: KENT_ZONE_FIELD=Short_Name (City of Kent PUB_PLAN layer), KING_ZONE_FIELD=CURRZONE
# Example URLs (verify with scripts/inspect_zoning_layer.py before production merge):
# KENT_ZONING=https://services3.arcgis.com/AME2ELqJ7UG0JjrU/arcgis/rest/services/PUB_PLAN_ZoningDistricts/FeatureServer/0
# KING_ZONING=https://gisdata.kingcounty.gov/arcgis/rest/services/OpenDataPortal/planning__zoning_area/MapServer/450
# OVERLAY_OUT=data/zoning/wa/king_kent_zoning_overlay.geojson   # host path when running build script
# Full pipeline (build → validate → merge): ./scripts/run_phase_b_pipeline.sh — see docs/PROCESS-COVERAGE.md

# --- Slack: 20-minute UTC digest (Beat → worker) — without BOTH token + channel, tasks skip (no Slack posts) ---
# Create a Slack app, install to workspace, Bot Token Scopes: chat:write. Invite the bot to the channel.
# Channel ID: right-click channel → View channel details → copy ID (starts with C).
# After setting, run: docker compose -f deploy/docker-compose.production.yml --env-file deploy/.env up -d worker beat
# SLACK_BOT_TOKEN=xoxb-your-bot-token
# SLACK_DIGEST_CHANNEL_ID=C01234567890
# Optional: dedicated channel for the two scoring agents (Atlas + Beacon) to post their daily comparison:
# SLACK_AGENT_DISCUSSION_CHANNEL_ID=C01234567890
# Optional: worker posts a Slack line after each ingest batch / pipeline run (can be noisy on bulk ingest):
# SLACK_AGENT_EVENT_UPDATES=1

# Optional: Celery Beat runs ingest_geojson_path on a schedule (file must exist inside the API container).
# Mount or bake the GeoJSON (e.g. bind-mount under /data). Defaults: 07:00 UTC daily.
# SCHEDULED_GEOJSON_INGEST_PATH=/data/county_parcels.geojson
# SCHEDULED_GEOJSON_INGEST_DEFAULT_COUNTY_FIPS=53033
# SCHEDULED_GEOJSON_INGEST_AUTO_RUN_PIPELINE=true
# SCHEDULED_GEOJSON_INGEST_MAX_AUTO_PIPELINE=200
# SCHEDULED_GEOJSON_INGEST_CRONTAB_HOUR=7
# SCHEDULED_GEOJSON_INGEST_CRONTAB_MINUTE=0

# Celery Beat: periodically enqueue run_pipeline for parcels with no parcel_scores yet (backlog drain).
# Default schedule every 4 hours at :25 UTC; disable with false if you only enqueue manually.
# SCHEDULED_ENQUEUE_UNSCORED_ENABLED=true
# SCHEDULED_ENQUEUE_UNSCORED_LIMIT=500
# SCHEDULED_ENQUEUE_UNSCORED_CRONTAB_MINUTE=5
# SCHEDULED_ENQUEUE_UNSCORED_CRONTAB_HOUR=*/1
#
# Celery worker processes (default 2; use 4 on 4-vCPU Droplet after bulk ingest — see scripts/wait_ingest_then_finalize.sh)
# CELERY_WORKER_CONCURRENCY=4

# Celery Beat: Cartographer + Beacon batch refreshes (same Celery tasks as Phase A HTTP calls).
# Enable after deploy when you want gaps to drain without running execute-phase-a.sh.
# SCHEDULED_REFRESH_IDENTIFICATION_ENABLED=true
# SCHEDULED_REFRESH_IDENTIFICATION_LIMIT=2000
# SCHEDULED_REFRESH_IDENTIFICATION_CRONTAB_MINUTE=10
# SCHEDULED_REFRESH_IDENTIFICATION_CRONTAB_HOUR=*/6
# SCHEDULED_REFRESH_IDENTIFICATION_COUNTY_FIPS=53033
# SCHEDULED_REFRESH_DEMAND_ENABLED=true
# SCHEDULED_REFRESH_DEMAND_LIMIT=2000
# SCHEDULED_REFRESH_DEMAND_CRONTAB_MINUTE=40
# SCHEDULED_REFRESH_DEMAND_CRONTAB_HOUR=*/6
# SCHEDULED_REFRESH_DEMAND_COUNTY_FIPS=53033

# Washington 7-day exploration campaign (optional): rotate county GeoJSON ingests daily (see docs/OPERATIONS.md).
# Requires parcel GeoJSON per county under data/exploration/{county_fips}.geojson on the Droplet (repo data/exploration/).
# Set START_DATE to day “1” of the campaign (UTC calendar days); after 7 days the Beat task no-ops until you bump dates.
# EXPLORATION_CAMPAIGN_ENABLED=true
# EXPLORATION_CAMPAIGN_START_DATE=2026-05-10
# EXPLORATION_CAMPAIGN_CONFIG_PATH=/app/config/exploration_campaign_wa.yaml
# EXPLORATION_CAMPAIGN_CRONTAB_HOUR=6
# EXPLORATION_CAMPAIGN_CRONTAB_MINUTE=30

# --- Pilot config (deterministic scoring inputs + weights) ---
# PILOT_CONFIG_PATH defaults to /app/config/pilot.yaml in compose.
# Optional alternate scoring profile config (Beacon) for dual-agent comparisons:
# PILOT_STRATEGIC_CONFIG_PATH=/app/config/pilot_strategic.yaml
# Ingest-time prescreen (Cartographer) — written when parcels load from GeoJSON:
# PILOT_IDENTIFICATION_CONFIG_PATH=/app/config/pilot_identification.yaml

# --- Postgres (Managed DO or optional container on this Droplet) ---
# Managed (DigitalOcean): sslmode=require, host from DO control panel / Terraform.
# DATABASE_URL=postgresql+psycopg://parking_api:YOUR_PASSWORD@YOUR_DB_HOST:25060/parking_app?sslmode=require
#
# Local PostGIS container (same VM, dev / bootstrap): set POSTGRES_PASSWORD and use the addon compose file
# (see deploy/docker-compose.postgis-addon.yml and scripts/droplet-provision-local-postgis-env.sh).
# POSTGRES_PASSWORD=generate-a-strong-secret
# DATABASE_URL=postgresql+psycopg://parking_api:SAME_PASSWORD@postgres:5432/parking_app?sslmode=disable
DATABASE_URL=postgresql+psycopg://parking_api:YOUR_PASSWORD@YOUR_DB_HOST:25060/parking_app?sslmode=require

# --- Redis (on this Droplet) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- DigitalOcean Spaces (S3-compatible contract drafts) ---
# Endpoint: terraform output spaces_bucket_endpoint (https://<region>.digitaloceanspaces.com)
# Bucket + runtime keys: terraform output spaces_bucket_name, spaces_runtime_access_key, spaces_runtime_secret_key
STORAGE_ENDPOINT=https://sfo3.digitaloceanspaces.com
STORAGE_ACCESS_KEY=PASTE_spaces_runtime_access_key
STORAGE_SECRET_KEY=PASTE_spaces_runtime_secret_key
STORAGE_BUCKET=your-unique-parking-drafts-bucket
STORAGE_REGION=us-east-1

# --- Phase runners (optional shell vars — see docs/PHASED-EXECUTION-PLAN-A-E.md, scripts/execute-phase-*.sh) ---
# INTERNAL_API_KEY must match this file when calling POST /internal/* from scripts.
# PHASE_A_API_BASE / PHASE_B_API_BASE / PHASE_C_API_BASE are usually ${PUBLIC_API_URL}, or
# http://127.0.0.1:8000 when running scripts inside the api container (docker compose exec).
# PHASE_B_OVERLAY_PATH must be readable by the worker (often /app/data/... inside containers).

# Self-signed TLS (browsers show a warning). Use when 80/443 are taken by another proxy
# and you publish this stack on alternate host ports (see deploy/.env CADDY_PUBLISH_*).
# For public Let's Encrypt on 80/443, use ./Caddyfile instead.

{
	email {$ACME_EMAIL}
}

{$UI_HOST} {
	tls internal
	encode gzip
	@operator path /operator /operator/ /operator/*
	handle @operator {
		reverse_proxy operator-console:3000
	}
	@operator_alias path /outreach /outreach/* /deals /deals/* /parcels /parcels/* /audit /audit/* /owners /owners/* /approvals /approvals/*
	handle @operator_alias {
		redir * /operator{uri} 308
	}
	handle {
		reverse_proxy approval-ui:3000
	}
}

{$API_HOST} {
	tls internal
	encode gzip
	reverse_proxy api:8000
}

# Copy to deploy/secrets.env (gitignored) and fill only what you want to override.
# Committed defaults stay in deploy/env.production.example.
#
#   cp deploy/secrets.env.example deploy/secrets.env
#   make render-deploy-env
#
# Output: deploy/.env (generated — do not edit by hand; re-run the renderer).

# --- Often overridden on the Droplet ---
# DATABASE_URL=postgresql+psycopg://user:password@host:25060/dbname?sslmode=require
# INTERNAL_API_KEY=
# SLACK_BOT_TOKEN=
# SLACK_DIGEST_CHANNEL_ID=

# --- Managed DO keys / buckets (if not using example placeholders) ---
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=

# --- Phase B — King/Kent zoning layer URLs (see docs/zoning-sources-kent.md) ---
# KENT_ZONING=https://services3.arcgis.com/AME2ELqJ7UG0JjrU/arcgis/rest/services/PUB_PLAN_ZoningDistricts/FeatureServer/0
# KING_ZONING=https://gisdata.kingcounty.gov/arcgis/rest/services/OpenDataPortal/planning__zoning_area/MapServer/450
# KENT_ZONE_FIELD=Short_Name
# KING_ZONE_FIELD=CURRZONE

# --- UI auth (if you use password login) ---
# AUTH_SECRET=
# AUTH_ADMIN_PASSWORD=

DATABASE_URL=postgresql+psycopg://parking:parking@postgres:5432/parking
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
PILOT_CONFIG_PATH=/app/config/pilot.yaml
PILOT_STRATEGIC_CONFIG_PATH=/app/config/pilot_strategic.yaml
STORAGE_ENDPOINT=http://minio:9000
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio12345
STORAGE_BUCKET=parking-drafts
STORAGE_REGION=us-east-1
API_PUBLIC_URL=http://localhost:8000
APP_VERSION=local

# Optional (production-style); local compose ignores if unset:
# CORS_ALLOW_ORIGINS=https://parking.example.com
# INTERNAL_API_KEY=

# Optional Slack standup (worker posts digest; beat schedules every 4h UTC — see docs/SLACK.md):
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_DIGEST_CHANNEL_ID=C...
# Optional: dual scoring agents (Atlas + Beacon) post 3 messages here — invite the bot to this channel:
# SLACK_AGENT_DISCUSSION_CHANNEL_ID=C...
# Per-task agent lines from worker (ingest + pipeline) — set to 1 to enable (can be chatty):
# SLACK_AGENT_EVENT_UPDATES=1

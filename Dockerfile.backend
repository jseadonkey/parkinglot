FROM python:3.12-slim AS base

ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION}

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    libnss3 libnspr4 libdbus-1-3 libatk1.0-0 libatk-bridge2.0-0 libcups2 \
    libdrm2 libxkbcommon0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
    libpango-1.0-0 libcairo2 libasound2 libglib2.0-0 libx11-6 libxext6 libxcb1 \
    xvfb xauth \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY packages/core /build/packages/core
COPY services/scoring /build/services/scoring
COPY services/ingestion /build/services/ingestion
COPY services/enrichment /build/services/enrichment
COPY services/workflows /build/services/workflows
COPY services/api /build/services/api

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir /build/packages/core \
    && pip install --no-cache-dir /build/services/scoring \
    && pip install --no-cache-dir /build/services/ingestion \
    && pip install --no-cache-dir /build/services/enrichment \
    && pip install --no-cache-dir /build/services/workflows \
    && pip install --no-cache-dir /build/services/api \
    && playwright install chromium

COPY services/api /app/services/api
WORKDIR /app/services/api
ENV PYTHONPATH=/app/services/api

COPY config /app/config
COPY data /app/data
COPY scripts /app/scripts

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4)"

CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000"]

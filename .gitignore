.env
.env.local
.env.github
.env.github.*
deploy/.env
# Droplet-side backups from db_url merge scripts — may contain DATABASE_URL; never commit
deploy/.env*.bak*
deploy/.env.env.bak.*
.venv
.uv-bin
# Accidental root snapshot from export_openapi_json.py -o openapi.json
/openapi.json
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.next/
out/
dist/
*.egg-info/
.DS_Store
*.swp
terraform.tfstate
terraform.tfstate.*
*.tfvars
!terraform.tfvars.example
.terraform/

# CrewAI audit outputs (keep output/.gitkeep)
services/crew/output/*.json
services/crew/output/*.md
!services/crew/output/.gitkeep
services/crew/.env

# Operator admin agent snapshots (Droplet + CI artifacts)
data/operator-agent/*.json
data/operator-agent/*.log
data/operator-agent/.auto-commit.lock
!data/operator-agent/.gitkeep

# Benton / Tri-Cities zoning GIS cache (regenerate via make benton-zoning-fetch)
data/benton/
# Pierce / county Phase B overlay build output (large; built on Droplet workers)
data/pierce/
# All county GIS overlay caches — rebuildable from source layers; some exceed
# GitHub's 100 MB limit and were the reason every push from the Droplet failed.
data/king/
data/snohomish/
data/kitsap/
data/thurston/
data/wa/
data/**/*.geojson
